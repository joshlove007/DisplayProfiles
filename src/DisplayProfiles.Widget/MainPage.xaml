<Page
    x:Class="DisplayProfiles.Widget.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">
        <StackPanel MaxWidth="460" VerticalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE7F4;" FontSize="40" HorizontalAlignment="Left" />
            <TextBlock Text="Display Profiles for Xbox Game Bar" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}"
                       Text="This is a Game Bar widget. Press Win + G (or the Xbox button on a controller), open the widget menu and choose Display Profiles." />
        </StackPanel>
    </Grid>
</Page>
