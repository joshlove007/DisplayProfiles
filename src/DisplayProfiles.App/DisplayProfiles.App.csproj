<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DisplayProfiles.App</RootNamespace>
    <AssemblyName>DisplayProfiles</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DisplayProfiles.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- The app is neither trimmed nor AOT-compiled, so collection expressions over read-only interfaces are fine. -->
    <NoWarn>$(NoWarn);CsWinRT1032</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DisplayProfiles.Core\DisplayProfiles.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- dotnet publish leaves out the compiled XAML (the app's .pri and the .xbf files) for unpackaged WinUI apps, so the
       published app would crash on start. Add them to the publish list. -->
  <Target Name="IncludeCompiledXamlInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_CompiledXaml Include="$(OutDir)$(AssemblyName).pri;$(OutDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_CompiledXaml)" RelativePath="$([MSBuild]::MakeRelative('$(OutDir)', '%(FullPath)'))" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
