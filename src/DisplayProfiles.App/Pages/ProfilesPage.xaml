<Page
    x:Class="DisplayProfiles.App.Pages.ProfilesPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:DisplayProfiles.App"
    xmlns:controls="using:DisplayProfiles.App.Controls"
    xmlns:vm="using:DisplayProfiles.App.ViewModels"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid x:Name="PageRoot" SizeChanged="OnPageSizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutGroup" CurrentStateChanged="OnLayoutStateChanged">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListPane.(Grid.Row)" Value="0" />
                        <Setter Target="ListPane.(Grid.RowSpan)" Value="1" />
                        <Setter Target="ListPane.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ListPane.Margin" Value="16,12,16,0" />
                        <Setter Target="ProfileListView.MaxHeight" Value="150" />
                        <Setter Target="EditorScroll.(Grid.Row)" Value="1" />
                        <Setter Target="EditorScroll.(Grid.RowSpan)" Value="1" />
                        <Setter Target="EditorScroll.(Grid.Column)" Value="0" />
                        <Setter Target="EditorScroll.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="EditorScroll.Padding" Value="16,12,16,16" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ListPane.(Grid.Row)" Value="0" />
                        <Setter Target="ListPane.(Grid.RowSpan)" Value="2" />
                        <Setter Target="ListPane.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="ListPane.Margin" Value="36,16,0,24" />
                        <Setter Target="ProfileListView.MaxHeight" Value="Infinity" />
                        <Setter Target="EditorScroll.(Grid.Row)" Value="0" />
                        <Setter Target="EditorScroll.(Grid.RowSpan)" Value="2" />
                        <Setter Target="EditorScroll.(Grid.Column)" Value="1" />
                        <Setter Target="EditorScroll.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="EditorScroll.Padding" Value="24,16,36,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="ListPane" Grid.RowSpan="2" Margin="36,16,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Display profiles" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <ListView
                x:Name="ProfileListView"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Profiles}"
                SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=OneWay}"
                SelectionChanged="OnProfileSelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileItem">
                        <Grid ColumnSpacing="8" Padding="0,10" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <FontIcon
                                Grid.Column="1"
                                Glyph="&#xE73E;"
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                ToolTipService.ToolTip="Currently active"
                                Visibility="{x:Bind app:Ui.Visible(IsActive), Mode=OneWay}" />
                            <Ellipse
                                Grid.Column="2"
                                Width="8"
                                Height="8"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                ToolTipService.ToolTip="Unsaved changes"
                                Visibility="{x:Bind app:Ui.Visible(IsDirty), Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Stretch" Click="OnNewProfileClick"
                    AutomationProperties.Name="New profile"
                    ToolTipService.ToolTip="Create a profile from the displays as they are right now">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New profile" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer x:Name="EditorScroll" Grid.Column="1" Grid.RowSpan="2" Padding="24,16,36,24">
            <StackPanel x:Name="EditorPanel" Spacing="16">

                <StackPanel Spacing="8" Visibility="{x:Bind app:Ui.Hidden(ViewModel.HasProfile), Mode=OneWay}" Margin="0,48,0,0">
                    <TextBlock Text="No profiles yet" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Create a profile from your current displays, then adjust it here." TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="16" Visibility="{x:Bind app:Ui.Visible(ViewModel.HasProfile), Mode=OneWay}">

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Profile name"
                            FontSize="20"
                            MaxLength="60" />

                        <Button Grid.Column="1" Click="OnSaveClick"
                                AutomationProperties.Name="Save"
                                ToolTipService.ToolTip="Save changes (Ctrl+S)"
                                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnApplyClick"
                                AutomationProperties.Name="Apply"
                                ToolTipService.ToolTip="Switch the displays to this layout"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="Apply" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="MoreButton" Grid.Column="3" AutomationProperties.Name="More options" Click="OnMoreClick">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Discard unsaved changes" Click="OnDiscardClick"
                                                    IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Create desktop shortcut" Click="OnDesktopShortcutClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Create Start menu shortcut" Click="OnStartMenuShortcutClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FC;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Duplicate" Click="OnDuplicateClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Move up" Click="OnMoveUpClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Move down" Click="OnMoveDownClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete" Click="OnDeleteClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <InfoBar
                        IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

                    <Border
                        Height="280"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <controls:MonitorLayoutView x:Name="LayoutView" />
                            <Button
                                Content="Identify"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,12"
                                Click="OnIdentifyClick" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Displays" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Monitors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonitorViewModel">
                                <tk:SettingsExpander
                                    Header="{x:Bind Title}"
                                    Description="{x:Bind Summary, Mode=OneWay}"
                                    Expanded="OnMonitorExpanded">
                                    <tk:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE7F4;" />
                                    </tk:SettingsExpander.HeaderIcon>
                                    <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                                    <tk:SettingsExpander.Items>
                                        <tk:SettingsCard Header="Make this my main display"
                                                         IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                                         Visibility="{x:Bind app:Ui.Visible(IsExtended), Mode=OneWay}">
                                            <CheckBox IsChecked="{x:Bind IsPrimary, Mode=TwoWay}" MinWidth="0" />
                                        </tk:SettingsCard>
                                        <tk:SettingsCard Header="Display resolution"
                                                         IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                                         Visibility="{x:Bind app:Ui.Visible(IsExtended), Mode=OneWay}">
                                            <controls:OptionPicker MinWidth="200" Title="Display resolution"
                                                       ItemsSource="{x:Bind ResolutionLabels}"
                                                       SelectedIndex="{x:Bind ResolutionIndex, Mode=TwoWay}" />
                                        </tk:SettingsCard>
                                        <tk:SettingsCard Header="Refresh rate"
                                                         IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                                         Visibility="{x:Bind app:Ui.Visible(IsExtended), Mode=OneWay}">
                                            <controls:OptionPicker MinWidth="200" Title="Refresh rate"
                                                       ItemsSource="{x:Bind RefreshLabels, Mode=OneWay}"
                                                       SelectedIndex="{x:Bind RefreshIndex, Mode=TwoWay}" />
                                        </tk:SettingsCard>
                                        <tk:SettingsCard Header="Display orientation"
                                                         IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                                         Visibility="{x:Bind app:Ui.Visible(IsExtended), Mode=OneWay}">
                                            <controls:OptionPicker MinWidth="200" Title="Display orientation"
                                                       ItemsSource="{x:Bind Orientations}"
                                                       SelectedIndex="{x:Bind OrientationIndex, Mode=TwoWay}" />
                                        </tk:SettingsCard>
                                        <tk:SettingsCard Header="Display mode"
                                                         IsEnabled="{x:Bind Enabled, Mode=OneWay}">
                                            <controls:OptionPicker MinWidth="200" Title="Display mode"
                                                       ItemsSource="{x:Bind ModeChoices, Mode=OneWay}"
                                                       SelectedIndex="{x:Bind ModeIndex, Mode=TwoWay}" />
                                        </tk:SettingsCard>
                                        <tk:SettingsCard Header="Remove this display"
                                                         Description="It isn't connected. This only removes it from this profile."
                                                         Visibility="{x:Bind app:Ui.Visible(CanRemove)}">
                                            <Button Content="Remove" Click="OnRemoveMonitorClick" />
                                        </tk:SettingsCard>
                                    </tk:SettingsExpander.Items>
                                </tk:SettingsExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
