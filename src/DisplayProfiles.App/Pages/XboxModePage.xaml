<Page
    x:Class="DisplayProfiles.App.Pages.XboxModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DisplayProfiles.App.Controls"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer x:Name="PageScroll" Padding="36,0,36,24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageScroll.Padding" Value="16,0,16,16" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageScroll.Padding" Value="36,0,36,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="4" MaxWidth="920">
            <TextBlock Text="Xbox mode" Style="{StaticResource TitleTextBlockStyle}" Margin="0,16,0,16" />

            <InfoBar x:Name="SupportBar" IsOpen="True" IsClosable="False" Margin="0,0,0,8" />

            <tk:SettingsCard
                Header="When Xbox mode starts"
                Description="Switch the displays to this profile as soon as the PC enters Xbox mode.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7FC;" />
                </tk:SettingsCard.HeaderIcon>
                <controls:OptionPicker x:Name="EnterBox" Title="When Xbox mode starts" MinWidth="240" SelectionChanged="OnSelectionChanged" />
            </tk:SettingsCard>

            <tk:SettingsCard
                Header="When Xbox mode ends"
                Description="Optionally switch back to another profile when the PC leaves Xbox mode.">
                <tk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </tk:SettingsCard.HeaderIcon>
                <controls:OptionPicker x:Name="ExitBox" Title="When Xbox mode ends" MinWidth="240" SelectionChanged="OnSelectionChanged" />
            </tk:SettingsCard>

            <InfoBar
                x:Name="StartupBar"
                Severity="Warning"
                IsClosable="False"
                Title="Display Profiles has to be running"
                Message="Turn on &quot;Start with Windows&quot; in Settings so profiles can switch when Xbox mode starts."
                Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
