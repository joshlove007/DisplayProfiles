{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/MonitorToggle.slnx", "--nologo", "-v:minimal"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "--solution", "${workspaceFolder}/MonitorToggle.slnx", "--nologo"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish app",
      "type": "process",
      "command": "dotnet",
      "args": ["publish", "${workspaceFolder}/src/MonitorToggle.App/MonitorToggle.App.csproj", "-c", "Release", "-r", "win-x64", "--nologo"],
      "problemMatcher": "$msCompile"
    }
  ]
}
